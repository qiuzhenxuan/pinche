.page {
  min-height: 100vh;
  background: #F2F2F7;
}

.body {
  padding: 16px 0 32px;
}

.pick {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #000000;
}

.chev {
  margin-left: 6px;
  color: #C7C7CC;
  font-size: 18px;
  line-height: 1;
}

/* 出发地 / 目的地：手打即可，下方给常用站点一点即填（地图选点接口没开通） */
.row-input {
  flex: 1;
  min-width: 0;
  font-size: 16px;
  color: #000000;
  text-align: right;
}

.pick-ph {
  color: #C7C7CC;
}

/* 输入行和它下面的胶囊是同一个字段，分割线改由胶囊块收尾，中间不留一条 */
.row-flush {
  border-bottom: none;
}

/* 非福州城市：常用站点不适用，胶囊收起，改给一句手填提示 */
.place-tip {
  margin: 0 16px 8px;
  font-size: 12px;
  line-height: 1.5;
  color: #8E8E93;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16px 12px;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.18);
}

.chip {
  margin: 0 8px 8px 0;
  padding: 0 12px;
  height: 30px;
  line-height: 30px;
  font-size: 13px;
  color: #007AFF;
  background: rgba(0, 122, 255, 0.1);
  border-radius: 15px;
}

/* 总价输入 */
.price-input-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.price-yuan {
  font-size: 17px;
  font-weight: 600;
  color: #000000;
  margin-left: 3px;
}

.price-input {
  min-width: 90px;
  text-align: right;
  font-size: 17px;
  font-weight: 600;
  color: #000000;
}

.price-ph {
  color: #AEAEB2;
  font-weight: 400;
}

/* 人均预览（置于页面顶部） */
.fare-tip {
  margin: 0 16px 16px;
  padding: 14px 16px;
  background: rgba(0, 122, 255, 0.08);
  border-radius: 12px;
}

.fare-tip-k {
  font-size: 13px;
  color: #3C3C43;
}

.fare-tip-v {
  font-size: 30px;
  font-weight: 700;
  color: #007AFF;
  line-height: 1.2;
  /* 大字号收一点字距：字号越大，默认字距读起来越松 */
  letter-spacing: -0.5px;
  margin: 2px 0 4px;
}

.fare-tip-desc {
  font-size: 12px;
  color: #8E8E93;
}

.note-wrap {
  position: relative;
  padding: 14px 16px 28px;
}

.note-input {
  width: 100%;
  height: 88px;
  font-size: 16px;
  line-height: 1.5;
  color: #000000;
}

.note-ph {
  color: #C7C7CC;
}

.note-count {
  position: absolute;
  right: 16px;
  bottom: 10px;
  font-size: 12px;
  color: #C7C7CC;
}

.notice {
  margin: 0 16px 20px;
  font-size: 13px;
  color: #8E8E93;
  line-height: 1.6;
}

.submit {
  padding: 0 16px;
}

/* 未完善资料时的拦截面板 */
.gate {
  margin: 0 16px;
  padding: 24px 20px;
  background: #FFFFFF;
  border-radius: 12px;
  text-align: center;
}

.gate-title {
  font-size: 18px;
  font-weight: 600;
  color: #000000;
}

.gate-desc {
  margin: 10px 0 20px;
  font-size: 13px;
  line-height: 1.6;
  color: #8E8E93;
}

/* ---------------- 深色模式 ---------------- */
@media (prefers-color-scheme: dark) {
  .page {
    background: #000000;
  }

  .pick {
    color: #FFFFFF;
  }

  .row-input {
    color: #FFFFFF;
  }

  .chips {
    border-bottom-color: rgba(255, 255, 255, 0.12);
  }

  .chip {
    color: #5AA9FF;
    background: rgba(10, 132, 255, 0.18);
  }

  .pick-ph {
    color: #6C6C70;
  }

  .place-tip {
    color: #98989F;
  }

  .price-yuan,
  .price-input {
    color: #FFFFFF;
  }

  .price-ph,
  .note-ph {
    color: #6C6C70;
  }

  .fare-tip {
    background: rgba(10, 132, 255, 0.16);
  }

  .fare-tip-k {
    color: #EBEBF5;
  }

  .fare-tip-v {
    color: #5AA9FF;
  }

  .fare-tip-desc {
    color: #98989F;
  }

  .note-input {
    color: #FFFFFF;
  }

  .note-count {
    color: #6C6C70;
  }

  .notice {
    color: #98989F;
  }

  .gate {
    background: #1C1C1E;
  }

  .gate-title {
    color: #FFFFFF;
  }

  .gate-desc {
    color: #98989F;
  }
}
