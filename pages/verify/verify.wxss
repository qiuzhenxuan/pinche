.page {
  min-height: 100vh;
  background: #F2F2F7;
}

.body {
  padding: 16px 0 120px;
}

/* 状态卡 */
.status-card {
  margin: 0 16px 20px;
  padding: 16px;
  border-radius: 12px;
  background: rgba(0, 122, 255, 0.08);
}

.status-pending {
  background: rgba(255, 149, 0, 0.10);
}

.status-verified {
  background: rgba(52, 199, 89, 0.10);
}

.status-rejected {
  background: rgba(255, 59, 48, 0.10);
}

.status-title {
  font-size: 17px;
  font-weight: 600;
  color: #007AFF;
}

.status-pending .status-title {
  color: #C77700;
}

.status-verified .status-title {
  color: #248A3D;
}

.status-rejected .status-title {
  color: #D92E24;
}

.status-tip {
  font-size: 13px;
  color: #6C6C70;
  line-height: 1.7;
  margin-top: 6px;
}

.status-reason {
  font-size: 13px;
  color: #D92E24;
  line-height: 1.7;
  margin-top: 6px;
}

/* 材料类型分段控件 */
.seg {
  display: flex;
  justify-content: flex-end;
}

.seg-item {
  height: 30px;
  line-height: 30px;
  padding: 0 12px;
  font-size: 14px;
  color: #8E8E93;
  background: rgba(120, 120, 128, 0.12);
  border-radius: 8px;
  /* 选中态颜色渐变过去，不做硬切 */
  transition: background-color 220ms cubic-bezier(0.32, 0.72, 0, 1),
    color 220ms cubic-bezier(0.32, 0.72, 0, 1),
    transform 110ms ease-out;
}

.seg-item + .seg-item {
  margin-left: 8px;
}

.seg-on {
  color: #FFFFFF;
  background: #007AFF;
  font-weight: 600;
}

.input {
  text-align: right;
  font-size: 16px;
}

.ph {
  color: #C7C7CC;
}

/* 上传区 */
.upload {
  margin: 12px;
  height: 176px;
  border-radius: 12px;
  border: 2rpx dashed #C7C7CC;
  background: rgba(120, 120, 128, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: transform 110ms ease-out;
}

.upload-img {
  display: block;
  width: 100%;
  height: 100%;
}

.upload-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 0 16px;
}

.upload-plus {
  font-size: 32px;
  line-height: 1;
  color: #C7C7CC;
}

.upload-text {
  font-size: 14px;
  line-height: 1.4;
  color: #8E8E93;
  margin-top: 10px;
  text-align: center;
}

.upload-meta {
  padding: 0 16px 6px;
  font-size: 13px;
  color: #8E8E93;
}

.upload-hint {
  padding: 0 16px 14px;
  font-size: 12px;
  color: #C7C7CC;
  line-height: 1.6;
}

/* 隐私说明 */
.notice {
  margin: 0 16px 20px;
  padding: 14px 16px;
  background: rgba(120, 120, 128, 0.08);
  border-radius: 12px;
}

.notice-title {
  font-size: 13px;
  font-weight: 600;
  color: #6C6C70;
  margin-bottom: 8px;
}

.notice-text {
  font-size: 13px;
  color: #6C6C70;
  line-height: 1.8;
}

.agree {
  display: flex;
  align-items: center;
  margin-top: 14px;
}

.checkbox {
  width: 20px;
  height: 20px;
  border-radius: 6px;
  border: 1rpx solid rgba(60, 60, 67, 0.36);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 13px;
  flex-shrink: 0;
}

.checkbox-on {
  background: #007AFF;
  border-color: #007AFF;
}

.agree-text {
  font-size: 14px;
  color: #1C1C1E;
  margin-left: 8px;
}

.agree-links {
  margin-top: 8px;
  padding-left: 28px;
}

.link {
  font-size: 13px;
  color: #007AFF;
}

.link + .link {
  margin-left: 10px;
}

/* 底部按钮：半透明材质，内容从下方滚过时被模糊，
   层级交给材质本身，而不是压一条 1rpx 硬分割线 */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 10px 16px;
  padding-bottom: calc(10px + constant(safe-area-inset-bottom));
  padding-bottom: calc(10px + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.84);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
}

/* 滚动边缘：内容滑到操作条下面时渐隐 */
.bar::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 100%;
  height: 16px;
  background: linear-gradient(0deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0));
  pointer-events: none;
}

.btn-off,
.btn-off:active {
  background: rgba(120, 120, 128, 0.2);
  color: #8E8E93;
}

/* 未完善资料时的拦截面板 */
.gate {
  margin: 0 16px;
  padding: 24px 20px;
  background: #FFFFFF;
  border-radius: 12px;
  text-align: center;
}

.gate-title {
  font-size: 18px;
  font-weight: 600;
  color: #000000;
}

.gate-desc {
  margin: 10px 0 20px;
  font-size: 13px;
  line-height: 1.6;
  color: #8E8E93;
}

/* ---------------- 深色模式 ---------------- */
@media (prefers-color-scheme: dark) {
  .page {
    background: #000000;
  }

  .status-card {
    background: rgba(10, 132, 255, 0.14);
  }

  .status-pending {
    background: rgba(255, 149, 0, 0.16);
  }

  .status-verified {
    background: rgba(48, 209, 88, 0.16);
  }

  .status-rejected {
    background: rgba(255, 69, 58, 0.16);
  }

  .status-title {
    color: #5AA9FF;
  }

  .status-pending .status-title {
    color: #FFB340;
  }

  .status-verified .status-title {
    color: #30D158;
  }

  .status-rejected .status-title {
    color: #FF6961;
  }

  .status-tip {
    color: #98989F;
  }

  .status-reason {
    color: #FF6961;
  }

  .seg-item {
    color: #98989F;
    background: rgba(120, 120, 128, 0.24);
  }

  .seg-on {
    background: #0A84FF;
  }

  .ph {
    color: #5A5A5E;
  }

  .upload {
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(120, 120, 128, 0.16);
  }

  .upload-plus {
    color: #5A5A5E;
  }

  .notice {
    background: rgba(120, 120, 128, 0.16);
  }

  .notice-title,
  .notice-text {
    color: #98989F;
  }

  .checkbox {
    border-color: rgba(255, 255, 255, 0.28);
  }

  .checkbox-on {
    background: #0A84FF;
    border-color: #0A84FF;
  }

  .agree-text {
    color: #FFFFFF;
  }

  .link {
    color: #5AA9FF;
  }

  .bar {
    background: rgba(28, 28, 30, 0.78);
  }

  .bar::before {
    background: linear-gradient(0deg, rgba(28, 28, 30, 0.85), rgba(28, 28, 30, 0));
  }

  .btn-off,
  .btn-off:active {
    background: rgba(120, 120, 128, 0.24);
    color: #98989F;
  }

  .gate {
    background: #1C1C1E;
  }

  .gate-title {
    color: #FFFFFF;
  }

  .gate-desc {
    color: #98989F;
  }
}

/* ---------------- 降低动效 ---------------- */
@media (prefers-reduced-motion: reduce) {
  .seg-item,
  .upload {
    transition: none;
  }
}

/* ---------------- 降低透明度 ---------------- */
@media (prefers-reduced-transparency: reduce) {
  .bar {
    background: #FFFFFF;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .bar::before {
    display: none;
  }
}

@media (prefers-reduced-transparency: reduce) and (prefers-color-scheme: dark) {
  .bar {
    background: #1C1C1E;
  }
}
