.page {
  min-height: 100vh;
  background: #F2F2F7;
}

.body {
  padding: 16px 0 110px;
}

/* 未登录时的引导面板 */
.gate {
  margin: 24px 16px 0;
  padding: 28px 20px 24px;
  background: #FFFFFF;
  border-radius: 16px;
}

.gate-title {
  font-size: 18px;
  font-weight: 600;
  color: #000000;
  text-align: center;
}

.gate-desc {
  margin: 10px 0 20px;
  font-size: 13px;
  line-height: 1.6;
  color: #8E8E93;
}

.hero {
  padding: 8px 16px 20px;
}

/* 路线条：浅浅的灰 + 玻璃描边（不用 filter，保证文字锐利） */
.island {
  display: flex;
  align-items: center;
  background: rgba(120, 120, 128, 0.1);
  border-radius: 18px;
  padding: 16px 18px;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
}

.island-point {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: 17px;
  font-weight: 700;
  color: #1C1C1E;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 12306 风格的醒目箭头 */
.route-arrow {
  position: relative;
  width: 40px;
  height: 14px;
  flex-shrink: 0;
  margin: 0 10px;
}

.route-arrow-bar {
  position: absolute;
  left: 0;
  top: 50%;
  margin-top: -2px;
  width: 31px;
  height: 4px;
  border-radius: 2px;
  background: linear-gradient(90deg, #0A84FF, #0060DF);
}

.route-arrow-tip {
  position: absolute;
  right: 0;
  top: 50%;
  margin-top: -7px;
  width: 0;
  height: 0;
  border-top: 7px solid transparent;
  border-bottom: 7px solid transparent;
  border-left: 9px solid #0A84FF;
}

.hero-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10px;
}

.hero-time {
  font-size: 15px;
  color: #8E8E93;
  text-align: center;
}

.pill {
  flex-shrink: 0;
  margin-left: 8px;
  height: 22px;
  line-height: 22px;
  padding: 0 10px;
  border-radius: 11px;
  font-size: 12px;
  font-weight: 600;
}

.pill-off {
  color: #8E8E93;
  background: rgba(120, 120, 128, 0.16);
}

.pill-warn {
  color: #C77700;
  background: rgba(255, 149, 0, 0.16);
}

.per-v {
  color: #007AFF;
  font-weight: 600;
}

.full-v {
  color: #FF9500;
  font-weight: 600;
}

.limit-v {
  color: #C77700;
  font-weight: 600;
}

.owner-line {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 上车申请列表 */
.apply-cell {
  flex: 1;
  min-width: 0;
}

.apply-name {
  font-size: 16px;
  color: #000000;
}

.apply-sub {
  font-size: 13px;
  color: #8E8E93;
  margin-top: 3px;
}

.apply-ops {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.op {
  min-width: 52px;
  height: 30px;
  line-height: 30px;
  text-align: center;
  font-size: 14px;
  border-radius: 8px;
  transition: transform 110ms ease-out;
}

.op + .op {
  margin-left: 8px;
}

.op-no {
  color: #8E8E93;
  background: rgba(120, 120, 128, 0.12);
}

.op-yes {
  color: #FFFFFF;
  background: #007AFF;
  font-weight: 600;
}

.empty-v {
  text-align: center;
  color: #C7C7CC;
}

.tips {
  margin: 0 16px;
  padding: 14px 16px;
  background: rgba(255, 149, 0, 0.08);
  border-radius: 12px;
}

.tips-title {
  font-size: 13px;
  font-weight: 600;
  color: #C77700;
  margin-bottom: 8px;
}

.tips-item {
  font-size: 13px;
  color: #8A6A33;
  line-height: 1.7;
}

.tips-item::before {
  content: '·';
  margin-right: 6px;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 10px 16px;
  padding-bottom: calc(10px + constant(safe-area-inset-bottom));
  padding-bottom: calc(10px + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.84);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
}

/* 滚动边缘：内容滑到操作条下面时渐隐，替代一条 1rpx 硬分割线 */
.bar::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 100%;
  height: 16px;
  background: linear-gradient(0deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0));
  pointer-events: none;
}

.btn-danger {
  background: #FF3B30;
}

.btn-danger:active {
  background: #D92E24;
}

.btn-done {
  background: rgba(120, 120, 128, 0.12);
  color: #8E8E93;
}

.btn-ghost {
  background: rgba(0, 122, 255, 0.1);
  color: #007AFF;
}

.btn-ghost:active {
  background: rgba(0, 122, 255, 0.18);
}

/* ---------------- 举报 / 拉黑确认弹窗 ---------------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24px;
  background: rgba(0, 0, 0, 0.45);
  animation: mask-in 220ms ease both;
}

.mask-out {
  animation: mask-out 190ms ease both;
}

@keyframes mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes mask-out {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

.dialog {
  width: 100%;
  max-width: 340px;
  padding: 24px 20px 18px;
  background: #FFFFFF;
  border-radius: 16px;
  box-sizing: border-box;
  /* 模态弹窗是居中的，所以从中心缩放：缩放和透明度一起动，
     读起来像一块材质落下来，而不只是淡入 */
  animation: dialog-in 340ms cubic-bezier(0.32, 0.72, 0, 1) both;
}

/* 退场是进场的镜像路径（同样缩回 0.96），但用 ease-in 更快收掉 */
.dialog-out {
  animation: dialog-out 190ms cubic-bezier(0.4, 0, 1, 1) both;
}

@keyframes dialog-in {
  from {
    opacity: 0;
    transform: scale(0.94);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes dialog-out {
  from {
    opacity: 1;
    transform: scale(1);
  }
  to {
    opacity: 0;
    transform: scale(0.96);
  }
}

.dialog-title {
  font-size: 17px;
  font-weight: 600;
  line-height: 22px;
  color: #000000;
  text-align: center;
}

.dialog-text {
  margin-top: 16px;
}

.dialog-line {
  position: relative;
  padding-left: 14px;
  font-size: 14px;
  line-height: 26px;
  color: #3C3C43;
}

.dialog-line::before {
  content: '';
  position: absolute;
  left: 0;
  top: 11px;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #C7C7CC;
}

.dialog-note {
  margin-top: 12px;
  padding: 10px 12px;
  font-size: 12px;
  line-height: 18px;
  color: #8A6A33;
  background: rgba(255, 149, 0, 0.08);
  border-radius: 10px;
}

.dialog-input {
  width: 100%;
  height: 46px;
  margin-top: 14px;
  padding: 0 14px;
  font-size: 15px;
  color: #000000;
  background: #F2F2F7;
  border-radius: 10px;
  box-sizing: border-box;
}

.dialog-ph {
  font-size: 14px;
  color: #A1A1A6;
}

/* 举报：原因选择 */
.dialog-sub {
  margin-top: 16px;
  font-size: 13px;
  line-height: 18px;
  color: #8E8E93;
}

.reason-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10px;
  margin-bottom: -8px;
}

.reason-chip {
  height: 36px;
  margin: 0 8px 8px 0;
  padding: 0 14px;
  font-size: 13px;
  line-height: 36px;
  color: #3C3C43;
  background: #F2F2F7;
  border-radius: 18px;
  transition: background-color 200ms cubic-bezier(0.32, 0.72, 0, 1),
    color 200ms cubic-bezier(0.32, 0.72, 0, 1),
    transform 110ms ease-out;
}

.reason-chip-on {
  color: #FFFFFF;
  background: #007AFF;
}

.dialog-textarea {
  width: 100%;
  min-height: 72px;
  margin-top: 6px;
  padding: 12px 14px;
  font-size: 14px;
  line-height: 20px;
  color: #000000;
  background: #F2F2F7;
  border-radius: 10px;
  box-sizing: border-box;
}

.dialog-ops {
  display: flex;
  margin-top: 20px;
}

.dialog-btn {
  flex: 1;
  height: 48px;
  line-height: 48px;
  text-align: center;
  font-size: 16px;
  border-radius: 12px;
  transition: opacity 160ms ease-out;
}

.dialog-cancel {
  margin-right: 12px;
  color: #3C3C43;
  background: #F2F2F7;
}

.dialog-danger {
  color: #FFFFFF;
  background: #FF3B30;
}

.dialog-primary {
  color: #FFFFFF;
  background: #007AFF;
}

.dialog-disabled {
  opacity: 0.5;
}

/* ---------------- 深色模式 ---------------- */
@media (prefers-color-scheme: dark) {
  .page {
    background: #000000;
  }

  .island {
    background: rgba(120, 120, 128, 0.24);
    box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.08);
  }

  .island-point {
    color: #FFFFFF;
  }

  .route-arrow-bar {
    background: linear-gradient(90deg, #5AA9FF, #0A84FF);
  }

  .per-v {
    color: #5AA9FF;
  }

  .full-v {
    color: #FFB340;
  }

  .limit-v {
    color: #FFB340;
  }

  .apply-name {
    color: #FFFFFF;
  }

  .op-no {
    color: #98989F;
    background: rgba(120, 120, 128, 0.24);
  }

  .op-yes {
    background: #0A84FF;
  }

  .empty-v {
    color: #6C6C70;
  }

  .btn-done {
    background: rgba(120, 120, 128, 0.24);
    color: #98989F;
  }

  .btn-ghost {
    background: rgba(10, 132, 255, 0.18);
    color: #5AA9FF;
  }

  .btn-ghost:active {
    background: rgba(10, 132, 255, 0.28);
  }

  .pill-off {
    color: #98989F;
    background: rgba(120, 120, 128, 0.24);
  }

  .pill-warn {
    color: #FFB340;
    background: rgba(255, 149, 0, 0.2);
  }

  .tips {
    background: rgba(255, 149, 0, 0.14);
  }

  .tips-title {
    color: #FFB340;
  }

  .tips-item {
    color: #D9A05B;
  }

  .bar {
    background: rgba(28, 28, 30, 0.78);
  }

  .bar::before {
    background: linear-gradient(0deg, rgba(28, 28, 30, 0.85), rgba(28, 28, 30, 0));
  }

  .dialog {
    background: #1C1C1E;
  }

  .dialog-title {
    color: #FFFFFF;
  }

  .dialog-line {
    color: #D1D1D6;
  }

  .dialog-note {
    color: #D9A05B;
    background: rgba(255, 149, 0, 0.14);
  }

  .dialog-input {
    color: #FFFFFF;
    background: #2C2C2E;
  }

  .dialog-ph {
    color: #8E8E93;
  }

  .reason-chip {
    color: #D1D1D6;
    background: #2C2C2E;
  }

  .reason-chip-on {
    background: #0A84FF;
  }

  .dialog-textarea {
    color: #FFFFFF;
    background: #2C2C2E;
  }

  .dialog-primary {
    background: #0A84FF;
  }

  .dialog-cancel {
    color: #D1D1D6;
    background: #2C2C2E;
  }

  .gate {
    background: #1C1C1E;
  }

  .gate-title {
    color: #FFFFFF;
  }

  .gate-desc {
    color: #98989F;
  }
}

/* ---------------- 降低动效 ----------------
   去掉缩放与位移动画，只保留帮助理解状态的透明度过渡。 */
@media (prefers-reduced-motion: reduce) {
  .mask,
  .mask-out,
  .dialog,
  .dialog-out {
    animation: none;
  }

  .mask-out {
    opacity: 0;
  }

  .dialog-out {
    opacity: 0;
  }

  .op,
  .reason-chip,
  .dialog-btn {
    transition: none;
  }
}

/* ---------------- 降低透明度 ----------------
   系统开了「降低透明度」就把毛玻璃换成实底，底部操作条与内容不再互相干扰。 */
@media (prefers-reduced-transparency: reduce) {
  .bar {
    background: #FFFFFF;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .bar::before {
    display: none;
  }
}

@media (prefers-reduced-transparency: reduce) and (prefers-color-scheme: dark) {
  .bar {
    background: #1C1C1E;
  }
}

